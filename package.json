{
  "name": "@react-native-ohos/react-native-file-selector",
  "version": "10.0.1-rc.1",
  "description": "React Native: Native File Selector",
  "keywords": [
    "react-native",
    "react-component",
    "react-native-component",
    "react",
    "mobile",
    "ohos",
    "harmony",
    "keychain"
  ],
  "homepage": "https://oblador.github.io/react-native-keychain",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/openharmony-sig/rntpc_react-native-file-selector.git"
  },
  "devDependencies": {
    "react-native": "0.72.2",
    "@rnoh/react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@^0.0.27"
  },
  "scripts":{
    "codegen-lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name react-native-file-selector --cpp-output-path ./harmony/file_selector/src/main/cpp/generated --ets-output-path ./harmony/file_selector/src/main/ets/generated --turbo-modules-spec-paths ./src/NativeFileSelector.ts"
  },
  "harmony": {
    "alias": "react-native-file-selector",
    "autolinking": {
      "etsPackageClassName": "FileSelectorPackage",
      "cppPackageClassName": "FileSelectorPackage",
      "cmakeLibraryTargetName": "rnoh_file_selector",
      "ohPackageName": "@react-native-ohos/react-native-file-selector"
    }
  },
  "keywords": [
    "react-native",
    "react-native-file-selector",
    "react",
    "native",
    "harmony"
  ],
  "license": "Apache License",
  
 "nativePackage": true,
   "main": "index.js"
}