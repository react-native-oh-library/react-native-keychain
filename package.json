{
  "name": "@react-native-ohos/react-native-keychain",
  "version": "10.0.1-beta.1",
  "description": "React Native Keychain API for HarmonyOS (RNOH port)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "codegen-lib": "react-native codegen-lib-harmony",
    "test": "jest --config jest/jest.config.js",
    "test:coverage": "jest --config jest/jest.config.js --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/runtime": "^7.25.0",
    "@types/jest": "^29.5.13",
    "babel-jest": "^29.6.3",
    "babel-plugin-istanbul": "^6.1.1",
    "jest": "^29.7.0",
    "react-native": "0.82.1"
  },
  "files": [
    "src",
    "harmony",
	"CHANGELOG.md",
	"README.md"
  ],
  "harmony": {
    "alias": "react-native-keychain",
    "autolinking": {
      "etsPackageClassName": "KeychainPackage",
      "cppPackageClassName": "RNKeychainPackage",
      "cmakeLibraryTargetName": "rnoh_keychain",
      "ohPackageName": "@react-native-ohos/react-native-keychain"
    }
  },
  "codegenConfig": {
    "name": "RNKeychainManagerSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.oblador.keychain"
    }
  },
  "peerDependencies": {
    "react-native": "*"
  }
}
